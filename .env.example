# 模板文件，不放真实密钥。复制为 .env 后填写；.env 已被 Git 忽略，不会提交。
# python run.py 启动时自动读取 .env（已有的环境变量优先）。详见 docs/部署说明.md。

# 模型（DeepSeek，OpenAI 兼容接口；程序自动追加 /chat/completions）
FINTECH_MODEL_BASE_URL=https://api.deepseek.com
FINTECH_MODEL_NAME=deepseek-flash
FINTECH_MODEL_API_KEY=

# 可选
# FINTECH_MODEL_MODE=live            # live=真实调用；replay=只回放 cassettes/ 里录制的演示（不需要密钥）
# FINTECH_MODEL_THINKING=disabled    # 关闭思考模式更快；enabled 打开
# FINTECH_PORT=8765
# FINTECH_HOST=127.0.0.1             # Docker 里用 0.0.0.0
# FINTECH_ALLOWED_HOSTS=             # 用其他主机名/端口访问时填写，逗号分隔，如 localhost:8080
# FINTECH_CHAT_RATE_PER_MIN=60       # 聊天限流（每个来源每分钟）
# FINTECH_SANDBOX_DOCKER=0           # 1 = 有 Docker 守护进程时用 Docker 跑沙箱分析代码

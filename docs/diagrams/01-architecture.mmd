flowchart TB
  subgraph UI["手机银行风格网页（PWA）"]
    U1["对话 · 首页提醒 · 账单 · 卡片 · 我的"]
    U2["确认面板 / 强验证面板<br/>（确认码、交易密码、动态码只在这里）"]
    U3["安全透视（决策链）· 模拟手机短信"]
  end
  UI -->|"HTTP /api/v2（CSRF + 同源 + 限流）"| AG
  subgraph AG["智能体编排层（src/agent）—— 模型提议"]
    G["① 输入守卫<br/>注入 / 信息套取 / 越权"]
    P["② 反诈预检<br/>风险名单号码"]
    L["③ 大模型工具调用循环<br/>DeepSeek · ≤6 步 · 工具白名单"]
    V["④ 参数溯源<br/>金额/收款人/日期必须来自用户原话"]
    F["⑤ 事实校验<br/>回复数字必须来自工具结果"]
    G --> P --> L --> V
    L --> F
  end
  V -->|"propose 只生成待确认单"| K
  U2 -->|"confirm / verify"| K
  subgraph K["安全内核（src/core）—— 代码裁决"]
    T["代码判档：绿 / 黄 / 红 / 拒绝<br/>当日累计 · 反诈评分 · 适当性"]
    C["确认绑定<br/>参数哈希 · 5 分钟 · 一次性"]
    S["强验证<br/>交易密码 + 模拟短信动态码"]
    X["执行前复查 + 执行<br/>余额 / 归属 / 累计 / 授权 / 重复"]
    A["只追加审计 + 哈希链<br/>与业务同一事务"]
    M["熔断（持久化）<br/>3 次失败锁 10 分钟 · 可疑行为只读"]
    T --> C --> X --> A
    T --> S --> X
  end
  K --> DB[("SQLite 模拟账本<br/>rich 种子 · 演示时钟 · 调度器")]
  L -.->|"长尾分析：模型写的代码"| SB["沙箱<br/>AST 白名单 · 子进程/无网络 · CPU/内存/超时"]
  SB -.->|"只读交易快照"| DB
